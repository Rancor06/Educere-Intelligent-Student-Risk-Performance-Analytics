DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=edutrack_db
FLASK_SECRET_KEY=replace_with_a_long_random_value_in_production
# Comma-separated list of allowed frontend origins (leave unset for "*" in dev)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# Set to 0 on any deployed/non-local run (Render, Railway, etc). When
# FLASK_DEBUG=0, the app REQUIRES FLASK_SECRET_KEY and CORS_ALLOWED_ORIGINS
# to be set and will refuse to start otherwise (see app.py). Defaults to 1
# (dev fallbacks allowed) when unset, so set this explicitly in production.
FLASK_DEBUG=0
